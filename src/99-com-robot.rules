# /etc/udev/rules.d/99-com-robot.rules
#
# ttyACM* 번호가 재부팅/재연결마다 바뀌는 문제(2026-08-11 실측: sensor_bridge가
# 엉뚱한 포트를 열어서 "Inappropriate ioctl for device" 크래시)를 없애기 위해
# USB vendor/product ID + 고유 시리얼번호로 항상 같은 이름의 심볼릭 링크를 만든다.
#
# 대상 3개:
#   - OpenCR                : idVendor=0483 idProduct=5740
#   - 센서보드 (Arduino Uno) : idVendor=2341 idProduct=0043 serial=1344B435234351D03947
#   - HMI보드  (Arduino Uno) : idVendor=2341 idProduct=0043 serial=1344B435234351D0E837
#
# 설치:
#   sudo cp 99-com-robot.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger
#
# 확인 (보드들 연결된 상태에서):
#   ls -l /dev/com_*
#   -> /dev/com_opencr, /dev/com_sensor_board, /dev/com_hmi_board 가 각각
#      실제 /dev/ttyACM* 로 연결되는 심볼릭 링크로 보여야 정상.

SUBSYSTEM=="tty", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5740", SYMLINK+="com_opencr", MODE="0666", GROUP="dialout"

SUBSYSTEM=="tty", ATTRS{idVendor}=="2341", ATTRS{idProduct}=="0043", ATTRS{serial}=="1344B435234351D03947", SYMLINK+="com_sensor_board", MODE="0666", GROUP="dialout"

SUBSYSTEM=="tty", ATTRS{idVendor}=="2341", ATTRS{idProduct}=="0043", ATTRS{serial}=="1344B435234351D0E837", SYMLINK+="com_hmi_board", MODE="0666", GROUP="dialout"
